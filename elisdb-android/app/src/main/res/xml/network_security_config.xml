<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!--
      The ElisDB server is self-hosted and may be reached by LAN IP/domain over
      plain HTTP, so cleartext is permitted here. Android's XML policy cannot
      express private CIDR ranges, so the authoritative restriction is enforced
      at runtime by ServerUrlPolicy / ApiClient: HTTP is accepted only for
      loopback, private, link-local and CGNAT hosts; HTTPS is accepted for any
      host. In production, terminate TLS in front of the server (e.g. Nginx
      Proxy Manager) and point the app at the HTTPS URL.
    -->
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
