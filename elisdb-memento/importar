#!/usr/bin/env bash
# Importa os clientes do export Memento para o servidor ElisDB.
# Comando único, sem opções: ./elisdb-memento/importar
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(cd "$here/.." && pwd)"

# O script só precisa de Python 3 e do módulo cryptography. No monorepo usamos
# o venv do servidor; numa VPS (onde o servidor corre em Docker) usamos o
# python3 ativo, desde que tenha o cryptography instalado.
candidatos=("$repo/elisdb-server/.venv/bin/python" "$here/.venv/bin/python" "$(command -v python3 || true)")
for python in "${candidatos[@]}"; do
  if [[ -n "$python" && -x "$python" ]] && "$python" -c "import cryptography" >/dev/null 2>&1; then
    exec "$python" "$here/importar_memento.py"
  fi
done

echo "Erro: não encontrei um Python 3 com o módulo 'cryptography'." >&2
echo "Cria um venv local e instala a dependência:" >&2
echo "  cd $here" >&2
echo "  python3 -m venv .venv" >&2
echo "  .venv/bin/pip install cryptography" >&2
echo "  ./importar" >&2
exit 1
