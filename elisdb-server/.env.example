# Copy to `.env` (chmod 600) and adjust. `.env` is gitignored; never commit it.
# All values are optional except ELISDB_SERVER_URL, which is required to issue
# a key for a device.

# Host directory mounted at /app/data: elisdb.db, photos/, apk/, backups/.
ELISDB_DATA_DIR=./elisdb-data

# URL the phones use to reach this server (e.g. https://elisdb.example.org).
ELISDB_SERVER_URL=

# Host uid/gid that must own elisdb-data/ and configs/ before `docker compose up`.
PUID=1000
PGID=1000

# Where port 8000 is published. Keep 127.0.0.1 when a TLS proxy is in front.
ELISDB_BIND_ADDRESS=127.0.0.1

# Runtime tunables (defaults match the server).
ELISDB_LOG_LEVEL=INFO
ELISDB_TRUST_PROXY=false
ELISDB_MAX_PUSH_RECORDS=200
ELISDB_MAX_PUSH_BYTES=67108864
ELISDB_MAX_PHOTOS_PER_CLIENT=500
ELISDB_MAX_PHOTO_BYTES=20971520
ELISDB_MAX_PHOTO_BYTES_PER_KEY=2147483648
ELISDB_MAX_PHOTO_BYTES_TOTAL=21474836480
ELISDB_RATE_LIMIT_REQUESTS=300
ELISDB_RATE_LIMIT_WINDOW_SECONDS=60
ELISDB_TOMBSTONE_RETENTION_DAYS=0
ELISDB_AUDIT_RETENTION_DAYS=0
ELISDB_PHOTO_GC_INTERVAL_SECONDS=3600

# Automatic backups. Interval in seconds (0 disables), how many `auto-*`
# backups to keep, and where they are written (default: <data dir>/backups).
# Manual pre-deploy/pre-migrate backups are never pruned.
ELISDB_BACKUP_INTERVAL_SECONDS=86400
ELISDB_BACKUP_RETENTION=3
ELISDB_BACKUP_DIR=
