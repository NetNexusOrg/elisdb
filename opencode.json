{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git push --delete*": "ask",
      "git push *:*": "ask",
      "git branch -D*": "ask",
      "git reset --hard*": "ask",
      "rm -r*": "ask",
      "gh repo delete*": "ask",
      "gh release delete*": "ask",
      "gh secret set*": "ask",
      "gh secret delete*": "ask",
      "gh variable set*": "ask"
    }
  }
}
